# -----------------------------------------------------------------------------
# Upliftra Network — Server Environment Variables
# Copy this file to .env and fill in the real values.
# NEVER commit .env to Git.
# -----------------------------------------------------------------------------

# -- Google Sheets API ---------------------------------------------------------
GOOGLE_SPREADSHEET_ID="your_spreadsheet_id_here"
GOOGLE_CLIENT_EMAIL="your_service_account_email_here"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----"

# -- JWT Auth ------------------------------------------------------------------
JWT_SECRET="your_jwt_secret_here"
JWT_EXPIRY=24h
JWT_REMEMBER_ME_EXPIRY=7d

# -- Server --------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# -- Client (Vite reads this via import.meta.env) -----------------------------
VITE_API_BASE_URL=http://localhost:3000
